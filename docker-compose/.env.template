# Secrets the discovery config references as ${NAME}. Uncomment and set only the ones
# your discovery.yaml uses: a variable left blank here is still set, as empty, and
# Deckard refuses an empty secret at startup.
# SPLUNK_HEC_TOKEN=
# WEBHOOK_TOKEN=
# JAMF_CLIENT_ID=
# JAMF_CLIENT_SECRET=
# AWS_ACCESS_KEY_ID_DISCOVERY=
# AWS_SECRET_ACCESS_KEY_DISCOVERY=

# Run a different Deckard release than this checkout's:
# https://github.com/arthur-ai/arthur-deckard/releases
# DECKARD_VERSION=

# Only for a source with no credentials of its own: let it use the container's
# ambient cloud credentials instead.
# ARTHUR_ENGINE_GCP_VERTEX_ALLOW_ADC=true
# ARTHUR_ENGINE_AWS_BEDROCK_ALLOW_DEFAULT_CREDENTIALS=true
